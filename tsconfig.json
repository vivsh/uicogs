{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@uicogs/core": ["packages/core/src/index.ts"],
      "@uicogs/echarts": ["packages/echarts/src/index.ts"],
      "@uicogs/routes": ["packages/routes/src/index.ts"],
      "@uicogs/auth": ["packages/auth/src/index.ts"],
      "@uicogs/http": ["packages/http/src/index.ts"],
      "@uicogs/vue": ["packages/vue/src/index.ts"],
      "@uicogs/react": ["packages/react/src/index.ts"],
      "@uicogs/quasar": ["packages/quasar/src/index.ts"],
      "@uicogs/openapi": ["packages/openapi/src/index.ts"],
      "@uicogs/storage": ["packages/storage/src/index.ts"],
      "@uicogs/legacy": ["packages/legacy/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "tests/integration/**/*.ts"
  ],
  "exclude": ["tests/types"]
}
