{
  "name": "uicogs",
  "version": "0.1.0",
  "private": true,
  "description": "Resource-first schemas and reactive client data workflows.",
  "license": "MIT",
  "author": "UiCogs",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "pnpm build && playwright test",
    "test:types": "tsd --typings packages/core/src/index.ts --files tests/types/index.test-d.ts && tsd --typings packages/echarts/src/index.ts --files tests/types/echarts.test-d.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:packages": "pnpm -r exec publint --pack=false",
    "check:standalone": "node scripts/check-standalone.mjs",
    "api:report": "pnpm build && node scripts/api-report.mjs --write",
    "api:check": "node scripts/api-report.mjs --check",
    "test:consumers": "node scripts/test-packed-consumers.mjs",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "budget:record": "pnpm build && node scripts/check-budgets.mjs --write",
    "budget:check": "node scripts/check-budgets.mjs --check",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:types && pnpm test:browser && pnpm build && pnpm check:standalone && pnpm check:packages",
    "release:check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:types && pnpm build && pnpm api:check && pnpm budget:check && pnpm test:browser && pnpm test:consumers && pnpm check:standalone && pnpm check:packages && pnpm audit:prod && pnpm sbom:generate"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.61.1",
    "@quasar/extras": "^2.0.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@uicogs/core": "workspace:*",
    "@uicogs/echarts": "workspace:*",
    "@uicogs/http": "workspace:*",
    "@uicogs/quasar": "workspace:*",
    "@uicogs/react": "workspace:*",
    "@uicogs/storage": "workspace:*",
    "@uicogs/vue": "workspace:*",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.2",
    "echarts": "^6.1.0",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "publint": "^0.3.17",
    "quasar": "^2.18.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsd": "^0.33.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^8.1.5",
    "vitest": "^4.0.18",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4",
    "yaml": "^2.8.2"
  },
  "tsd": {
    "directory": "tests/types"
  }
}
