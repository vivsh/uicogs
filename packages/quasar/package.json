{
  "name": "@uicogs/quasar",
  "version": "0.1.0",
  "description": "Quasar components and descriptor resolvers for UiCogs.",
  "license": "MIT",
  "author": "UiCogs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external vue --external quasar"
  },
  "dependencies": {
    "@uicogs/core": "workspace:^",
    "@uicogs/vue": "workspace:^"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "quasar": "^2.18.0",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
