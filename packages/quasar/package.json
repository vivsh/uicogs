{
  "name": "@uicogs/quasar",
  "version": "0.1.0",
  "description": "Quasar components and descriptor resolvers for UiCogs.",
  "license": "MIT",
  "author": "UiCogs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./stylebook": {
      "import": {
        "types": "./dist/stylebook.d.ts",
        "default": "./dist/stylebook.js"
      },
      "require": {
        "types": "./dist/stylebook.d.cts",
        "default": "./dist/stylebook.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./src/stylebook.css",
    "./dist/stylebook.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/stylebook.ts --format esm,cjs --dts --inject-style --external vue --external quasar --external vue-router --external @uicogs/echarts --external echarts"
  },
  "dependencies": {
    "@uicogs/core": "workspace:^",
    "@uicogs/echarts": "workspace:^",
    "@uicogs/vue": "workspace:^",
    "dompurify": "^3.4.13"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "quasar": "^2.18.0",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0",
    "echarts": "^6.1.0"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
